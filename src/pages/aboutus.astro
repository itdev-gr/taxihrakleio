---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://www.lptaxiheraklio.com';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/aboutus/` }
  ]
};

const aboutPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About LP Taxi Heraklion",
  "url": `${siteUrl}/aboutus/`,
  "mainEntity": {
    "@type": "Person",
    "name": "Lampros",
    "jobTitle": "Founder & Driver",
    "worksFor": { "@id": "https://www.lptaxiheraklio.com/#business" }
  }
};

const jsonLd = [breadcrumbJsonLd, aboutPageJsonLd];
---

<Layout title="About Us | Taxi Heraklion - LP Taxi" description="Meet the team behind LP Taxi Heraklion. Professional drivers born and raised in Crete offering safe, luxurious rides." jsonLd={jsonLd}>
  <!-- Page Header -->
  <section class="relative pt-32 pb-20 bg-navy overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-gold rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="about.header.tag">Get to Know Us</span>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-3 mb-6" data-i18n="about.header.title">About LP Taxi</h1>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto" data-i18n="about.header.subtitle">
        Your trusted partner for safe, luxurious transportation across the beautiful island of Crete.
      </p>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="about.story.tag">Our Story</span>
          <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="about.story.title">Elevating the Journey, Enriching Lives</h2>
          <p class="text-gray-600 text-lg mb-6 leading-relaxed" data-i18n="about.story.text1">
            At LP Taxi Heraklion, we believe that every journey is an opportunity to elevate the transportation experience for our passengers. As a small taxi company operating in Heraklion, Crete, we are committed to delivering premium service and exceeding customer expectations with every ride.
          </p>
          <p class="text-gray-600 mb-6 leading-relaxed" data-i18n="about.story.text2">
            We view transportation not just as a means of getting from point A to point B, but as an experience. Whether you're embarking on a scenic tour of Crete's countryside, catching a flight at the airport, or simply commuting to work, we are here to make your journey as enjoyable and memorable as possible.
          </p>
          <p class="text-gray-600 leading-relaxed" data-i18n="about.story.text3">
            Together, let's make every journey a journey worth remembering.
          </p>
          <p class="text-gray-600 mt-6 leading-relaxed" data-i18n="about.story.text4">
            Every vehicle in our fleet is fully licensed by the Greek Ministry of Transport and covered by comprehensive passenger insurance, so you travel with complete peace of mind. We comply with all Cretan taxi regulations, undergo regular safety inspections, and maintain our Mercedes vehicles to the highest mechanical and cosmetic standards. Our drivers hold professional taxi licences and receive ongoing training in safe driving practices and passenger care, because we believe that trust is earned at every single kilometre of the journey.
          </p>
          <p class="text-gray-600 mt-6 leading-relaxed" data-i18n="about.story.text5">
            For airport transfers we go one step further with real-time flight monitoring. If your flight is delayed, rescheduled, or lands early, your driver knows before you even step off the plane and adjusts the pick-up time automatically — no frantic calls, no extra charges. Combined with our transparent, fixed-price policy, you always know exactly what you will pay before you book. There are no hidden fees, no surge pricing, and no surprises: just honest, straightforward fares and a driver waiting for you with a smile.
          </p>
        </div>

        <div class="relative">
          <div class="rounded-2xl overflow-hidden">
            <img src="/images/who_we_are.avif" alt="LP Taxi Heraklion team" class="w-full h-auto" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="about.values.tag">What Drives Us</span>
        <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="about.values.title">Our Values</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-gold/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-3" data-i18n="about.values.service.title">Exceptional Service</h3>
          <p class="text-gray-600" data-i18n="about.values.service.desc">We are dedicated to providing unparalleled service that goes above and beyond the ordinary. From the moment you book a ride with us to the time you reach your destination, we strive to make every interaction seamless, comfortable, and memorable. Our drivers are not just chauffeurs but ambassadors of hospitality, embodying warmth, professionalism, and attentiveness at every turn.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-gold/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-3" data-i18n="about.values.expertise.title">Local Expertise</h3>
          <p class="text-gray-600" data-i18n="about.values.expertise.desc">With our intimate knowledge of Heraklion and its surroundings, we offer more than just transportation – we provide insider insights, personalized recommendations, and local guidance to enhance your experience. Whether you're a visitor exploring the island's attractions or a resident commuting to work, we take pride in navigating the city's streets with efficiency and expertise, ensuring you reach your destination safely and on time.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-gold/10 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-3" data-i18n="about.values.excellence.title">Commitment to Excellence</h3>
          <p class="text-gray-600" data-i18n="about.values.excellence.desc">We hold ourselves to the highest standards of quality and integrity in everything we do. From maintaining a fleet of well-maintained vehicles to investing in ongoing training and development for our drivers, we are dedicated to continuous improvement and innovation. We embrace feedback from our customers and strive to adapt and evolve in response to their needs, ensuring that we always deliver service of the highest caliber.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the Team -->
  <section class="py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="about.team.tag">The People Behind the Wheel</span>
        <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="about.team.title">Meet the Team</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg" data-i18n="about.team.subtitle">
          Our dedicated team ensures every ride is safe, comfortable, and memorable.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Team Member 1 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow group">
          <div class="w-72 h-72 mx-auto mb-8 rounded-2xl overflow-hidden bg-gradient-to-br from-navy to-navy-light border-4 border-cream group-hover:border-gold transition-colors">
            <div class="w-full h-full bg-[url('/images/labros.avif')] bg-cover bg-center"></div>
          </div>
          <h3 class="text-2xl font-bold text-navy mb-4 text-center">Lampros</h3>
          <div class="space-y-3">
            <p class="text-gray-600 text-sm leading-relaxed" data-i18n="about.team.lampros.text1">Meet Lampros, your friendly neighborhood taxi driver with a passion to make every journey memorable. A devoted family man with an entrepreneurial spirit, hoping to become a familiar and trusted face in his community.</p>
            <p class="text-gray-600 text-sm leading-relaxed" data-i18n="about.team.lampros.text2">With a warm smile and a welcoming demeanor, Lampros goes above and beyond to ensure his passengers feel comfortable and valued from the moment they step into his cab. Whether it's a quick ride to the airport or a leisurely tour of the city, Lampros prides himself on delivering exceptional service with a personal touch.</p>
          </div>
        </div>

        <!-- Team Member 2 -->
        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow group">
          <div class="w-72 h-72 mx-auto mb-8 rounded-2xl overflow-hidden bg-gradient-to-br from-navy to-navy-light border-4 border-cream group-hover:border-gold transition-colors">
            <div class="w-full h-full bg-[url('/images/IMG_3579.avif')] bg-cover bg-center"></div>
          </div>
          <h3 class="text-2xl font-bold text-navy mb-4 text-center">Popi</h3>
          <div class="space-y-3">
            <p class="text-gray-600 text-sm leading-relaxed" data-i18n="about.team.popi.text1">Meet Popi, your taxi driver dedicated to elevating the transportation experience for every passenger she serves. With a heart as warm as her smile, Popi embodies hospitality and professionalism, striving to exceed customer expectations with every ride.</p>
            <p class="text-gray-600 text-sm leading-relaxed" data-i18n="about.team.popi.text2">Drawing from years of experience navigating the Heraklion's streets, Popi possesses an intimate knowledge of the best routes and shortcuts to ensure her passengers reach their destinations swiftly and comfortably. Whether it's a short commute downtown, transportation to the airport or a longer journey across town, Popi's commitment to customer satisfaction remains unwavering.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fleet -->
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="about.fleet.tag">Our Fleet</span>
        <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="about.fleet.title">Travel in Comfort</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg" data-i18n="about.fleet.subtitle">Our fleet of modern Mercedes vehicles ensures a premium experience on every ride.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow text-center">
          <div class="w-14 h-14 bg-gold/10 rounded-xl flex items-center justify-center mb-6 mx-auto">
            <svg class="w-7 h-7 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H18.75M2.25 14.25h1.5m14.063 0H18.75m-14.063 0a1.5 1.5 0 00-1.5 1.5v1.5m14.063-3H5.812" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-3" data-i18n="about.fleet.sedan.title">Sedan</h3>
          <p class="text-gray-600 mb-4" data-i18n="about.fleet.sedan.desc">Mercedes E-Class or similar. Perfect for 1-3 passengers with luggage.</p>
          <div class="flex justify-center gap-6 text-sm text-gray-500">
            <span data-i18n="about.fleet.sedan.passengers">Up to 4</span>
            <span data-i18n="about.fleet.sedan.bags">3 bags</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow text-center">
          <div class="w-14 h-14 bg-gold/10 rounded-xl flex items-center justify-center mb-6 mx-auto">
            <svg class="w-7 h-7 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H18.75M2.25 14.25h1.5m14.063 0H18.75m-14.063 0a1.5 1.5 0 00-1.5 1.5v1.5m14.063-3H5.812" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-3" data-i18n="about.fleet.minivan.title">Minivan</h3>
          <p class="text-gray-600 mb-4" data-i18n="about.fleet.minivan.desc">Mercedes Viano/Vito. Ideal for families and small groups.</p>
          <div class="flex justify-center gap-6 text-sm text-gray-500">
            <span data-i18n="about.fleet.minivan.passengers">Up to 7</span>
            <span data-i18n="about.fleet.minivan.bags">7 bags</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow text-center">
          <div class="w-14 h-14 bg-gold/10 rounded-xl flex items-center justify-center mb-6 mx-auto">
            <svg class="w-7 h-7 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H18.75M2.25 14.25h1.5m14.063 0H18.75m-14.063 0a1.5 1.5 0 00-1.5 1.5v1.5m14.063-3H5.812" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-navy mb-3" data-i18n="about.fleet.minibus.title">Minibus</h3>
          <p class="text-gray-600 mb-4" data-i18n="about.fleet.minibus.desc">Mercedes Sprinter. Perfect for larger groups and organized tours.</p>
          <div class="flex justify-center gap-6 text-sm text-gray-500">
            <span data-i18n="about.fleet.minibus.passengers">Up to 19</span>
            <span data-i18n="about.fleet.minibus.bags">19 bags</span>
          </div>
        </div>
      </div>

      <div class="mt-12 bg-white rounded-2xl p-8 shadow-sm">
        <h3 class="text-xl font-bold text-navy mb-4" data-i18n="about.fleet.amenities.title">Amenities on Every Ride</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.ac">Air conditioning</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.wifi">Free WiFi</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.water">Complimentary water</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.childseats">Child seats on request</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.charging">Phone charging cables</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.clean">Professionally cleaned</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.nonsmoking">Non-smoking vehicles</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span class="text-gray-600" data-i18n="about.fleet.amenities.luggage">Spacious luggage storage</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="about.coverage.tag">Service Area</span>
          <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="about.coverage.title">We Cover All of Crete</h2>
          <p class="text-gray-600 text-lg mb-6 leading-relaxed" data-i18n="about.coverage.text1">
            Based in Heraklion, we serve the entire island of Crete. From airport transfers and hotel pickups to full-day tours and long-distance rides, no destination is out of reach. Our drivers know every road, shortcut, and scenic route across all four prefectures.
          </p>
          <p class="text-gray-600 mb-8 leading-relaxed" data-i18n="about.coverage.text2">
            Whether you need a ride from Heraklion Airport to your hotel in Elounda, a day trip to Chania, or a transfer to the south coast beaches, we are here for you — 24 hours a day, 7 days a week.
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-cream rounded-xl p-4">
              <h4 class="font-bold text-navy text-sm mb-1" data-i18n="about.coverage.heraklion">Heraklion Prefecture</h4>
              <p class="text-gray-500 text-xs" data-i18n="about.coverage.heraklion.desc">Airport, city center, Hersonissos, Malia, Matala, Archanes</p>
            </div>
            <div class="bg-cream rounded-xl p-4">
              <h4 class="font-bold text-navy text-sm mb-1" data-i18n="about.coverage.lassithi">Lassithi Prefecture</h4>
              <p class="text-gray-500 text-xs" data-i18n="about.coverage.lassithi.desc">Agios Nikolaos, Elounda, Sitia, Ierapetra, Vai</p>
            </div>
            <div class="bg-cream rounded-xl p-4">
              <h4 class="font-bold text-navy text-sm mb-1" data-i18n="about.coverage.rethymno">Rethymno Prefecture</h4>
              <p class="text-gray-500 text-xs" data-i18n="about.coverage.rethymno.desc">Rethymno town, Bali, Plakias, Preveli, Arkadi</p>
            </div>
            <div class="bg-cream rounded-xl p-4">
              <h4 class="font-bold text-navy text-sm mb-1" data-i18n="about.coverage.chania">Chania Prefecture</h4>
              <p class="text-gray-500 text-xs" data-i18n="about.coverage.chania.desc">Chania town, Balos, Elafonisi, Samaria Gorge, Falasarna</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-navy to-navy-light">
            <div class="absolute inset-0 bg-[url('/images/DSC_8108.jpg')] bg-cover bg-center"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gold">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
