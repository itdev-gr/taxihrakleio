            <tr class="bg-cream"><td class="px-5 py-3">Hersonissos</td><td class="px-5 py-3">28 km</td><td class="px-5 py-3">25–30 min</td></tr>
            <tr><td class="px-5 py-3">Fodele</td><td class="px-5 py-3">30 km</td><td class="px-5 py-3">30 min</td></tr>
            <tr class="bg-cream"><td class="px-5 py-3">Malia</td><td class="px-5 py-3">35 km</td><td class="px-5 py-3">35 min</td></tr>
            <tr><td class="px-5 py-3">Bali</td><td class="px-5 py-3">43 km</td><td class="px-5 py-3">40 min</td></tr>
            <tr class="bg-cream"><td class="px-5 py-3">Matala</td><td class="px-5 py-3">70 km</td><td class="px-5 py-3">60–75 min</td></tr>
          </tbody>
        </table>
      </div>

      <p><a href="/booktaxionline/" class="text-gold font-semibold hover:underline">Book your beach taxi transfer online</a> or call us to plan your perfect beach day.</p>
    </div>

    <!-- Bottom CTA -->
    <div class="mt-16 p-8 sm:p-10 rounded-2xl bg-navy text-center">
