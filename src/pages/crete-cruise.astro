---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://www.lptaxiheraklio.com';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Crete Cruise", "item": `${siteUrl}/crete-cruise/` }
  ]
};

const touristTripJsonLd = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": "Crete Cruise — Private Taxi Tour",
  "description": "Custom private taxi tours across Crete. Beaches, ruins, villages — half-day and full-day cruises with your own driver.",
  "touristType": { "@type": "Audience", "audienceType": "Sightseeing tourists" },
  "image": `${siteUrl}/images/DSC_8108.jpg`,
  "provider": { "@id": "https://www.lptaxiheraklio.com/#business" },
  "url": `${siteUrl}/crete-cruise/`
};

const jsonLd = [breadcrumbJsonLd, touristTripJsonLd];
---

<Layout title="Crete Cruise Tours | Private Taxi Tours | LP Taxi" description="Custom private taxi tours across Crete. Beaches, ruins, villages - half-day and full-day cruises with your own driver." jsonLd={jsonLd}>
  <!-- Page Header -->
  <section class="relative pt-32 pb-20 bg-navy overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-gold rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="cruise.header.tag">Explore Crete</span>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-3 mb-6" data-i18n="cruise.header.title">Crete Cruise</h1>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto" data-i18n="cruise.header.subtitle">
        Discover the beauty of Crete with our custom road cruises. Tell us what you love, and we'll plan the perfect route.
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="cruise.intro.tag">Custom Tours</span>
          <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="cruise.intro.title">Your Crete, Your Way</h2>
          <p class="text-gray-600 text-lg mb-6 leading-relaxed" data-i18n="cruise.intro.text1">
            Our Crete Cruise is a fully customizable road tour of the island. Tell us what sites you'd like to see — from archaeological wonders and pristine beaches to charming villages and traditional restaurants — and we'll plan the right road cruise for you.
          </p>
          <p class="text-gray-600 mb-8 leading-relaxed" data-i18n="cruise.intro.text2">
            Our drivers are born and raised in Crete. They know the hidden gems, the scenic routes, and the best local spots that most tourists never find. Whether you're arriving by cruise ship and have a day to explore, or you want a multi-day adventure, we'll create an unforgettable experience.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/booktaxionline/" class="inline-flex items-center justify-center gap-2 bg-gold hover:bg-gold-light text-navy font-semibold px-6 py-3 rounded-xl transition-all">
              <span data-i18n="cruise.intro.bookBtn">Book a Crete Cruise</span>
            </a>
            <a href="tel:+306943551122" class="inline-flex items-center justify-center gap-2 text-navy font-semibold px-6 py-3 rounded-xl border-2 border-navy hover:bg-navy hover:text-white transition-all">
              <span data-i18n="cruise.intro.callBtn">Call to Discuss</span>
            </a>
          </div>
        </div>

        <!-- IMAGE: Replace with scenic Crete landscape -->
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-navy to-navy-light">
            <div class="absolute inset-0 bg-[url('/images/LRM_EXPORT_19584388799415_20190127_204940514_edited.avif')] bg-cover bg-center"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Routes -->
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="cruise.routes.tag">Suggested Routes</span>
        <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="cruise.routes.title">Popular Cruises</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg" data-i18n="cruise.routes.subtitle">
          Not sure where to go? Here are some of our most popular routes, or we can customize any tour to your preferences.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Knossos & History -->
        <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all">
          <!-- IMAGE: Replace with Knossos ruins photo -->
          <div class="h-64 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('/images/knossos.avif')] bg-cover bg-center opacity-70 group-hover:scale-105 transition-transform duration-500"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 to-transparent"></div>
            <div class="absolute bottom-4 left-6 right-6">
              <span class="inline-block bg-gold/90 text-navy text-xs font-bold px-3 py-1 rounded-full mb-2" data-i18n="cruise.routes.halfDay">Half Day</span>
              <h3 class="text-2xl font-bold text-white" data-i18n="cruise.routes.knossos.title">Knossos & Heraklion History Tour</h3>
            </div>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-2" data-i18n="cruise.routes.knossos.desc">Visit the legendary Palace of Knossos, explore the Archaeological Museum of Heraklion, and walk through the historic city center with its Venetian architecture, lion fountain, and old harbor.</p>
            <p class="text-gray-500 text-sm mb-4" data-i18n="cruise.routes.knossos.details">Stops include the Palace of Knossos (1.5-2 hours), the Heraklion Archaeological Museum (1 hour), Morosini Fountain at Lions Square, the Venetian harbor, and a coffee break in the old town. Ideal for cruise ship passengers with limited port time. Your driver picks you up at Heraklion harbor and has you at Knossos within 20 minutes. Includes door-to-door transport in an air-conditioned Mercedes, bottled water, and local tips from your driver.</p>
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                4-5 hours
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                Heraklion area
              </span>
            </div>
            <a href="/booktaxionline/" class="inline-flex items-center gap-2 text-gold font-semibold hover:gap-3 transition-all">
              <span data-i18n="cruise.routes.bookTour">Book This Tour</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- South Coast Beaches -->
        <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all">
          <!-- IMAGE: Replace with south coast beach photo -->
          <div class="h-64 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('/images/IMG_3579.avif')] bg-cover bg-center opacity-70 group-hover:scale-105 transition-transform duration-500"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 to-transparent"></div>
            <div class="absolute bottom-4 left-6 right-6">
              <span class="inline-block bg-gold/90 text-navy text-xs font-bold px-3 py-1 rounded-full mb-2" data-i18n="cruise.routes.fullDay">Full Day</span>
              <h3 class="text-2xl font-bold text-white" data-i18n="cruise.routes.beach.title">South Coast Beach Adventure</h3>
            </div>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-2" data-i18n="cruise.routes.beach.desc">Escape to the stunning south coast of Crete. Visit the famous Matala beach with its hippie caves, the palm forest of Preveli, and the charming seaside village of Plakias.</p>
            <p class="text-gray-500 text-sm mb-4" data-i18n="cruise.routes.beach.details">The day begins with a scenic drive through the Messara Plain to the Minoan palace of Phaistos (optional stop, 45 minutes). Continue to Matala for swimming and a beachfront lunch among the ancient cliff caves. After Matala, head west along the coast to Preveli where a short hike leads to the famous palm beach. End the day in Plakias for a sunset drink before the drive home. Includes transport, bottled water, and flexible scheduling — stay longer at any stop you love.</p>
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                7-8 hours
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                South Crete
              </span>
            </div>
            <a href="/booktaxionline/" class="inline-flex items-center gap-2 text-gold font-semibold hover:gap-3 transition-all">
              <span data-i18n="cruise.routes.bookTour">Book This Tour</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- East Crete -->
        <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all">
          <!-- IMAGE: Replace with Spinalonga or Elounda photo -->
          <div class="h-64 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('/images/IMG_1279.avif')] bg-cover bg-center opacity-70 group-hover:scale-105 transition-transform duration-500"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 to-transparent"></div>
            <div class="absolute bottom-4 left-6 right-6">
              <span class="inline-block bg-gold/90 text-navy text-xs font-bold px-3 py-1 rounded-full mb-2" data-i18n="cruise.routes.fullDay">Full Day</span>
              <h3 class="text-2xl font-bold text-white" data-i18n="cruise.routes.east.title">Agios Nikolaos & Elounda</h3>
            </div>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-2" data-i18n="cruise.routes.east.desc">Discover the cosmopolitan Agios Nikolaos with its picturesque Voulismeni Lake, visit luxurious Elounda, and take a boat to the historic island of Spinalonga.</p>
            <p class="text-gray-500 text-sm mb-4" data-i18n="cruise.routes.east.details">Drive east along the coast through Hersonissos and the Gulf of Mirabello. First stop is Agios Nikolaos for coffee by the lake and a walk along the harbor. Continue to Elounda where you board a boat to Spinalonga Island (boat tickets not included). Explore the Venetian fortress and former leper colony for about an hour, then return to the mainland for a seafood lunch in the fishing village of Plaka. Includes door-to-door transport, bottled water, and a flexible itinerary.</p>
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                6-7 hours
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                East Crete
              </span>
            </div>
            <a href="/booktaxionline/" class="inline-flex items-center gap-2 text-gold font-semibold hover:gap-3 transition-all">
              <span data-i18n="cruise.routes.bookTour">Book This Tour</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- West Crete -->
        <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all">
          <!-- IMAGE: Replace with Chania/Rethymno photo -->
          <div class="h-64 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('/images/IMG_1280.avif')] bg-cover bg-center opacity-70 group-hover:scale-105 transition-transform duration-500"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy/80 to-transparent"></div>
            <div class="absolute bottom-4 left-6 right-6">
              <span class="inline-block bg-gold/90 text-navy text-xs font-bold px-3 py-1 rounded-full mb-2" data-i18n="cruise.routes.fullDay">Full Day</span>
              <h3 class="text-2xl font-bold text-white" data-i18n="cruise.routes.west.title">Rethymno & Chania Explorer</h3>
            </div>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-2" data-i18n="cruise.routes.west.desc">Journey west to the enchanting cities of Rethymno and Chania. Explore Venetian harbors, Ottoman architecture, winding old town streets, and stunning coastal views.</p>
            <p class="text-gray-500 text-sm mb-4" data-i18n="cruise.routes.west.details">Head west along the national highway with an optional stop at the Bali coves for a quick swim. Arrive in Rethymno for a walk through the old town and the Fortezza fortress. After lunch at a Venetian harbor taverna, continue to Chania to explore the famous lighthouse, the covered market, and the picturesque old port. On the return drive, enjoy views of the White Mountains and the north coast. Includes door-to-door transport, bottled water, and complete flexibility to adjust the route.</p>
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                8-10 hours
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                West Crete
              </span>
            </div>
            <a href="/booktaxionline/" class="inline-flex items-center gap-2 text-gold font-semibold hover:gap-3 transition-all">
              <span data-i18n="cruise.routes.bookTour">Book This Tour</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-gold font-semibold text-sm tracking-widest uppercase" data-i18n="cruise.included.tag">Every Tour Includes</span>
        <h2 class="font-display text-4xl font-bold text-navy mt-3 mb-6" data-i18n="cruise.included.title">What's Included in Your Crete Cruise</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg" data-i18n="cruise.included.subtitle">
          No hidden extras. Everything listed below is covered in your tour price from the moment we pick you up to the moment we drop you off.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Left column: checklist items -->
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <span class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-gold/15 flex items-center justify-center">
              <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-navy mb-1" data-i18n="cruise.included.item1.title">Door-to-Door Pickup</h3>
              <p class="text-gray-600 text-sm leading-relaxed" data-i18n="cruise.included.item1.desc">We collect you directly from your hotel, Airbnb, villa, or cruise ship port — and drop you back at the same address when the day is done. No taxis to flag down, no meeting points to navigate.</p>
            </div>
          </li>

          <li class="flex items-start gap-4">
            <span class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-gold/15 flex items-center justify-center">
              <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-navy mb-1" data-i18n="cruise.included.item2.title">Air-Conditioned Mercedes Vehicle</h3>
              <p class="text-gray-600 text-sm leading-relaxed" data-i18n="cruise.included.item2.desc">Travel in comfort in a late-model Mercedes sedan or minivan depending on the size of your group. Both vehicles are kept immaculate and serviced regularly. Crete's summer heat is real — you'll be grateful for the climate control.</p>
            </div>
          </li>

          <li class="flex items-start gap-4">
            <span class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-gold/15 flex items-center justify-center">
              <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-navy mb-1" data-i18n="cruise.included.item3.title">Bottled Water &amp; Phone Charging</h3>
              <p class="text-gray-600 text-sm leading-relaxed" data-i18n="cruise.included.item3.desc">Complimentary chilled bottled water is provided for every passenger. USB charging cables for both iPhone and Android are available in the vehicle so your phone stays charged for photos all day.</p>
            </div>
          </li>

          <li class="flex items-start gap-4">
            <span class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-gold/15 flex items-center justify-center">
              <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-navy mb-1" data-i18n="cruise.included.item4.title">English-Speaking Local Driver-Guide</h3>
              <p class="text-gray-600 text-sm leading-relaxed" data-i18n="cruise.included.item4.desc">Your driver is born and raised in Crete and speaks fluent English. Expect more than directions — they'll share stories about the island's history, point out the best local tavernas, and help you get the most out of every stop along the route.</p>
            </div>
          </li>

          <li class="flex items-start gap-4">
            <span class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-gold/15 flex items-center justify-center">
              <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <div>
              <h3 class="font-semibold text-navy mb-1" data-i18n="cruise.included.item5.title">Free Child Seats on Request</h3>
              <p class="text-gray-600 text-sm leading-relaxed" data-i18n="cruise.included.item5.desc">Travelling with young children? We provide approved child seats at no extra charge. Just let us know the age and weight of your child when you book so we can fit the right seat before pickup.</p>
            </div>
          </li>
        </ul>

        <!-- Right column: flexibility paragraph + note on entrance fees -->
        <div class="space-y-8">
          <div class="bg-cream rounded-2xl p-8">
            <h3 class="font-display text-2xl font-bold text-navy mb-4" data-i18n="cruise.included.flex.title">Your Schedule, Your Rules</h3>
            <p class="text-gray-600 leading-relaxed mb-4" data-i18n="cruise.included.flex.text1">
              One of the biggest differences between a private cruise and a group tour is time. On a group tour, the bus leaves when the bus leaves — whether you're ready or not. With us, the day moves at your pace.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4" data-i18n="cruise.included.flex.text2">
              Fell in love with a beach? Stay another hour. Found a taverna you never want to leave? No problem. Want to skip one of the suggested stops because the kids are tired? Consider it skipped. Your driver adapts the itinerary in real time based on what you want.
            </p>
            <p class="text-gray-600 leading-relaxed" data-i18n="cruise.included.flex.text3">
              We can also build a completely custom route from scratch. Just tell us your interests — archaeological sites, scenic gorges, traditional mountain villages, swimming spots, food and wine, or a mix of everything — and we'll put together an itinerary that fits your group.
            </p>
          </div>

          <div class="border-l-4 border-gold pl-6">
            <h4 class="font-semibold text-navy mb-2" data-i18n="cruise.included.note.title">A Note on Entrance Fees</h4>
            <p class="text-gray-600 text-sm leading-relaxed" data-i18n="cruise.included.note.text">
              Entrance tickets to archaeological sites and attractions — such as the Palace of Knossos, the Heraklion Archaeological Museum, or the Spinalonga boat crossing — are not included in the tour price. These are paid directly at the site. Your driver will let you know the current ticket prices in advance so there are no surprises on the day.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-24 bg-white">
