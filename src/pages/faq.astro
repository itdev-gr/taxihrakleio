---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://www.lptaxiheraklio.com';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "FAQ", "item": `${siteUrl}/faq/` }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does a taxi from Heraklion Airport to the city center cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A taxi from Heraklion International Airport (Nikos Kazantzakis, IATA: HER) to Heraklion city center typically costs between €20 and €25 for a standard sedan. The airport is located just 5 kilometers east of the city center, and the ride takes approximately 10 to 15 minutes depending on traffic conditions. With LP Taxi, you benefit from fixed, pre-agreed pricing with no hidden surcharges — there are no extra fees for luggage, night transfers, or flight delays. The price you see when you book online is exactly what you pay upon arrival. We also offer transfers to destinations further afield: Hersonissos costs €40–€50, Malia €50–€60, Agios Nikolaos €80–€100, Elounda €90–€110, Rethymno €90–€110, and Chania €180–€220. All prices are per vehicle, not per passenger, making taxi transfers very economical for families and groups."
      }
    },
    {
      "@type": "Question",
      "name": "Can I book a taxi in Heraklion in advance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, and we strongly recommend it. Pre-booking your Heraklion taxi ensures a professional driver is waiting for you the moment you arrive, whether at the airport, the port, or your hotel. You can book online through our website at any time — the booking form is available 24 hours a day, 7 days a week. Alternatively, you can call or message us directly via phone or WhatsApp. When you pre-book, you receive an instant confirmation with your driver's details, the vehicle type, and the fixed fare. There is no prepayment required — you pay the driver directly at the end of your ride. We monitor all incoming flights in real time, so if your flight is delayed, your driver will adjust accordingly at no extra charge. Pre-booking is especially recommended during the peak summer season from June to September, when taxi demand at Heraklion Airport is very high."
      }
    },
    {
      "@type": "Question",
      "name": "Are taxis available 24 hours in Heraklion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, LP Taxi Heraklion operates around the clock — 24 hours a day, 7 days a week, 365 days a year, including all public holidays and weekends. Whether you have an early morning flight departing at 5:00 AM, a late-night ferry arrival at Heraklion Port, or need a ride back to your hotel after a night out in the city, we are always available. Our fleet of modern, air-conditioned Mercedes vehicles is ready to serve you at any hour. There are no extra surcharges for early morning or late-night pickups when you book in advance with LP Taxi. Simply submit your booking through our website with your desired pickup time, or call us directly. We also provide service for last-minute requests whenever driver availability permits, so do not hesitate to contact us even on short notice."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get from Heraklion Airport to my hotel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The easiest and most comfortable way to reach your hotel from Heraklion Airport is to book a private taxi transfer with LP Taxi. When you arrive, your driver will be waiting in the arrivals hall holding a name sign with your name on it. They will assist you with all your luggage and escort you directly to a clean, air-conditioned Mercedes vehicle parked nearby. You will be driven straight to your hotel door — no shared shuttles, no bus stops, no unnecessary waiting. We serve all hotels across Crete, including those in Heraklion city center (10–15 minutes), Hersonissos (25–30 minutes), Malia (35–40 minutes), Agios Nikolaos (60–70 minutes), Elounda (70–80 minutes), Rethymno (75–90 minutes), and even Chania (approximately 2.5 hours). Child seats and booster seats are available upon request at no additional cost. For families with children or travelers with heavy luggage, a private taxi transfer is by far the most convenient airport transport option in Crete."
      }
    },
    {
      "@type": "Question",
      "name": "Is it safe to take a taxi in Crete?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, taking a taxi in Crete is very safe, and LP Taxi Heraklion is one of the most trusted and highly rated taxi services on the island. All of our drivers are fully licensed by the Greek authorities, professionally trained, and have years of driving experience on Crete's roads. Our fleet consists of modern, well-maintained, and fully insured Mercedes-Benz vehicles equipped with air conditioning and GPS navigation. Every ride is tracked for your safety. We have served hundreds of satisfied customers, including families with young children, solo travelers, and elderly passengers, earning consistent 5-star reviews on Google and TripAdvisor. Our drivers speak English fluently and are happy to assist you with any questions about your trip. We also offer complimentary child seats upon request. Unlike hailing a random taxi from the street, booking with LP Taxi gives you the peace of mind of knowing your driver's identity, vehicle details, and fixed fare in advance."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a taxi from Heraklion to Hersonissos or Malia cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A taxi from Heraklion Airport to Hersonissos costs between €40 and €50, while a transfer to Malia ranges from €50 to €60. These are fixed prices per vehicle (not per person), so they represent excellent value for couples, families, and groups of up to four passengers traveling together. The drive to Hersonissos takes approximately 25 to 30 minutes via the E75 national highway, and Malia is about 35 to 40 minutes further east along the same route. With LP Taxi, the fare is agreed upon in advance during booking, and there are no hidden charges — no meter surprises, no extra fees for luggage or late-night arrivals. For other popular destinations, indicative taxi fares from Heraklion Airport are: Heraklion city center €20–€25, Agios Nikolaos €80–€100, Elounda €90–€110, Rethymno €90–€110, and Chania €180–€220. All prices include meet-and-greet service at the arrivals hall, luggage assistance, and a comfortable ride in a modern Mercedes vehicle."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer private tours and day trips from Heraklion?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, in addition to airport and hotel transfers, LP Taxi offers fully customizable private tours and day trips across the island of Crete. Our most popular excursions include visits to the ancient Minoan Palace of Knossos (just 15 minutes from Heraklion), the picturesque old town and Venetian harbor of Rethymno, the stunning Elounda Bay and Spinalonga Island, the Lasithi Plateau with its famous windmills, and the beautiful south-coast beaches of Matala and Preveli. All tours are conducted in comfortable, air-conditioned Mercedes vehicles with a knowledgeable local driver who can share insights about Cretan history, culture, and cuisine along the way. Tours can be tailored to your interests and schedule — whether you prefer archaeological sites, scenic mountain villages, wine tasting, olive oil farms, or beach hopping. Half-day and full-day options are available. Contact us to discuss your ideal itinerary, and we will provide a competitive fixed quote with no hidden fees."
      }
    },
    {
      "@type": "Question",
      "name": "What payment methods do you accept?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LP Taxi Heraklion accepts cash in euros, credit and debit cards (Visa and Mastercard), and contactless payments. There is no prepayment required when you book — you simply pay the driver at the end of your journey. This means you can book with full confidence and settle the fare once you have safely reached your destination. Receipts are available on request for business travelers or anyone who needs documentation of their travel expenses. We keep our payment process as straightforward and transparent as possible, with no booking fees, no card surcharges, and no hidden extras added at the end of your ride."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide child seats?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, LP Taxi Heraklion provides child seats free of charge. We carry infant seats, child seats, and booster seats suitable for children of all ages and sizes. Simply request the appropriate seat type at the time of booking — let us know your child's age and weight so we can prepare the correct restraint system for your journey. Greek law requires all children under 135 cm in height to travel in an appropriate child restraint system. Our drivers are trained in the correct installation of child seats, so you can travel with complete peace of mind knowing your little ones are safe and secure throughout the ride."
      }
    },
    {
      "@type": "Question",
      "name": "Can you wait for me at a destination?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, LP Taxi Heraklion offers waiting time as part of our service. Whether you are stopping for shopping in Heraklion city center, enjoying a meal at a taverna, spending a few hours on the beach, or visiting the Knossos Palace archaeological site, your driver can wait for you and take you back when you are ready. Waiting time is already included in our private tour and excursion packages, so there are no additional charges for planned stops during a booked day trip. For standard airport and hotel transfers, we allow the first 30 minutes of waiting free of charge in the event of a delayed flight. For longer waits beyond that initial period, an agreed hourly waiting rate applies. Please mention your waiting requirements at the time of booking so we can plan accordingly and ensure your driver is available for the full duration."
      }
    }
  ]
};
